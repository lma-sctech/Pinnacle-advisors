[flake8]
max-line-length = 100
exclude =
    .git,
    __pycache__,
    */migrations/*,
    venv,
    .venv,
    *.pyc,
    .pytest_cache,
    .mypy_cache
ignore =
    # W503: line break before binary operator (conflicts with Black)
    W503,
    # E203: whitespace before ':' (conflicts with Black)
    E203,
    # E501: line too long (handled by Black)
    E501
per-file-ignores =
    __init__.py:F401
max-complexity = 10
