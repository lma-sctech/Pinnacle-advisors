# ============================================================================
# RENDER.COM ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy these variables to your Render dashboard (Environment tab)
# Replace placeholder values with real values
#
# IMPORTANT: Never commit real values to Git!
# ============================================================================

# ============================================================================
# DJANGO CORE SETTINGS
# ============================================================================

# Django Secret Key (CRITICAL - Generate new key for production!)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-production-key-here-CHANGE-ME

# Debug mode (ALWAYS False in production)
DEBUG=False

# Allowed hosts (your Render domain + custom domain if any)
# Format: pinnacle-backend.onrender.com,api.yourdomain.com
ALLOWED_HOSTS=pinnacle-backend.onrender.com

# Production flag for Render
RENDER=true
PRODUCTION=true

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database URL (Auto-populated by Render from database service)
# Format: postgresql://user:password@hostname:port/database_name
# DO NOT SET MANUALLY - Render fills this automatically when you link the database
# DATABASE_URL=<auto-populated-by-render>

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis URL for Celery (Auto-populated by Render from Redis service)
# Format: redis://hostname:port
# DO NOT SET MANUALLY - Render fills this automatically when you link Redis
# REDIS_URL=<auto-populated-by-render>

# Alternative if using external Redis (e.g., Upstash)
# CELERY_BROKER_URL=redis://default:password@hostname:port

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Frontend URLs allowed to access the API
# Format: comma-separated list of origins
# Example: https://pinnacle-advisors.vercel.app,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ============================================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================================

# Email backend for production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Server (Gmail example - use app-specific password!)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# SMTP Credentials
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# Default sender emails
DEFAULT_FROM_EMAIL=noreply@pinnacle-advisors.tech
SERVER_EMAIL=admin@pinnacle-advisors.tech

# CRM notification recipients (comma-separated)
CRM_NOTIFICATION_EMAILS=contact@pinnacle-advisors.tech,sales@pinnacle-advisors.tech

# ============================================================================
# LOGGING
# ============================================================================

# Django logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=WARNING

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Django settings module (use default)
# DJANGO_SETTINGS_MODULE=config.settings

# Gunicorn workers (default: 2 for Render free tier)
# WEB_CONCURRENCY=2

# Python version (specified in render.yaml)
# PYTHON_VERSION=3.11.9

# ============================================================================
# CLOUDINARY (If using for media files)
# ============================================================================

# Get these from cloudinary.com dashboard
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ============================================================================
# NOTES FOR CONFIGURATION
# ============================================================================
#
# 1. SECRET_KEY: Generate new unique key for production
# 2. ALLOWED_HOSTS: Add your Render domain (e.g., pinnacle-backend.onrender.com)
# 3. CORS_ALLOWED_ORIGINS: Add your Vercel frontend URL
# 4. DATABASE_URL: Auto-filled by Render when you link PostgreSQL service
# 5. REDIS_URL: Auto-filled by Render when you link Redis service
# 6. EMAIL_*: Configure SMTP (Gmail, SendGrid, AWS SES, etc.)
#
# ============================================================================
